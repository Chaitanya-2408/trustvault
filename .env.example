
# Flask
SECRET_KEY=your_secret_key
DATABASE_URL=sqlite:///trustvault.db
COOKIE_SECURE=false

# Email / SMTP
MAIL_SERVER=
MAIL_PORT=587
MAIL_USE_TLS=true
MAIL_USE_SSL=false
MAIL_USERNAME=
MAIL_PASSWORD=
MAIL_DEFAULT_SENDER=TrustVault <no-reply@example.com>

# Keep email sending disabled during development
MAIL_SUPPRESS_SEND=true
